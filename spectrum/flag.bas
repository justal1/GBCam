10 REM UNION FLAG
20 BORDER 1: PAPER 7: INK 1: INVERSE 0: OVER 0: CLS
30 REM BLUE FIELD, HATCHED
40 FOR y=24 TO 151 STEP 2
50 PLOT 0,y: DRAW 255,0
60 NEXT y
70 REM WHITE DIAGONALS
80 INVERSE 1: INK 7
90 FOR o=-14 TO 14
100 PLOT 0,24+o: DRAW 255,127
110 PLOT 0,151+o: DRAW 255,-127
120 NEXT o
130 REM RED DIAGONALS
140 INVERSE 0: INK 2
150 FOR o=-4 TO 4
160 PLOT 0,24+o: DRAW 255,127
170 PLOT 0,151+o: DRAW 255,-127
180 NEXT o
190 REM WHITE CROSS
200 INVERSE 1: INK 7
210 FOR y=75 TO 100: PLOT 0,y: DRAW 255,0: NEXT y
220 FOR x=115 TO 140: PLOT x,24: DRAW 0,127: NEXT x
230 REM RED CROSS
240 INVERSE 0: INK 2
250 FOR y=83 TO 92: PLOT 0,y: DRAW 255,0: NEXT y
260 FOR x=123 TO 132: PLOT x,24: DRAW 0,127: NEXT x
270 REM TRIM THE EDGES
280 INVERSE 1: INK 7
290 FOR y=0 TO 23: PLOT 0,y: DRAW 255,0: NEXT y
300 FOR y=152 TO 175: PLOT 0,y: DRAW 255,0: NEXT y
310 INVERSE 0: INK 0
320 PLOT 0,24: DRAW 255,0: DRAW 0,127: DRAW -255,0: DRAW 0,-127
330 PRINT AT 20,9;"THE UNION FLAG"
340 STOP
