10 REM FLOWER (after ZX Printer manual program 6)
20 CLS
30 LET q=.6875
40 FOR i=0 TO 240 STEP .5
50 PLOT 128+30*SIN (i/60*PI),88+q*120*COS (i/120*PI)
60 PLOT 128+120*COS (i/120*PI),88+q*30*SIN (i/60*PI)
70 PLOT 128+40*SIN (i/120*PI),88+q*40*COS (i/120*PI)
80 PLOT 128+80*SIN (i/120*PI)+20*SIN (i/60*PI),88+q*(80*SIN (i/120*PI)-20*SIN (i/60*PI))
90 PLOT 128+80*SIN (i/120*PI)+20*SIN (i/60*PI),88+q*(20*SIN (i/60*PI)-80*SIN (i/120*PI))
100 NEXT i
110 PRINT AT 21,0;"Type COPY to print this"
